# Git Identity Configuration
GIT_NAME="Your Name"
GIT_EMAIL="your.email@example.com"

# ZeroTier Configuration
# Leave empty to skip ZeroTier installation and join
ZEROTIER_NETWORK_ID=""

# Username of the developer account on this machine (defaults to $USER if empty)
DEV_USER=""

# Optional: Your personal fork of ArduPilot to add as a remote named 'fork'
# Example: git@github.com:your-github-username/ardupilot.git
ARDUPILOT_FORK_URL=""

# Optional: Space-separated list of additional repositories to clone into ~/projects
# Example: "git@github.com:your-github-username/plane_maker.git git@github.com:your-github-username/another-repo.git"
EXTRA_REPOS_TO_CLONE=""

# Optional: NVIDIA driver branch to install (e.g. "595"). Always uses the
# "-open" kernel modules (required for RTX 50xx / Blackwell).
# Leave empty to use whatever `ubuntu-drivers devices` recommends.
NVIDIA_DRIVER_BRANCH=""

# Optional: CUDA toolkit apt package from NVIDIA's repo (e.g. "cuda-toolkit-13-0"
# to pin a version). Defaults to "cuda-toolkit" (latest). Set to "" to skip CUDA.
# CUDA_TOOLKIT_PACKAGE="cuda-toolkit"

# Optional: GPU research environment (setup_research.sh)
# Name of the shared conda env with PyTorch + JupyterLab (default "research")
# RESEARCH_ENV="research"
# PyTorch wheel index; cu128 is the oldest CUDA build that supports RTX 50xx
# TORCH_INDEX_URL="https://download.pytorch.org/whl/cu128"
# JUPYTER_PORT="8888"
